# Where the Department Portal API lives. The Inspection Portal proxies /api here.
#   Production:      https://go.stationclipboard.com
#   Local api-server: http://localhost:8080
API_TARGET=https://go.stationclipboard.com

# Port the Inspection Portal itself listens on.
PORT=4710

# Link back to the Department Portal (used for "Department Portal" links).
VITE_DEPARTMENT_PORTAL_URL=https://go.stationclipboard.com

# Link to the Command Portal (used for "Open the preplan" links).
VITE_COMMAND_PORTAL_URL=https://cmd.stationclipboard.com

# Esri ArcGIS key for address lookup (server-side only, never sent to the browser).
# Optional: without it lookups still work, but a key is needed to keep found positions
# under Esri's terms. Free account: https://location.arcgis.com
ARCGIS_API_KEY=
